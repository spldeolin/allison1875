<script setup lang="ts">
/**
 * 页面覆盖模板 — 复制此文件并重命名为 {FormName}Page.vue
 *
 * 使用方式:
 *   1. cp TEMPLATE.vue.example OrderPage.vue
 *   2. 在 "自定义逻辑" 区域添加你的按钮、弹框、API 调用
 *   3. 保存即生效（路由自动发现）
 *
 * useCrudPage 接受 getter: () => props.schema
 *
 * useCrudPage 返回值:
 *   状态: searchParams, tableData, tableLoading, pagination,
 *         checkedRowKeys, editingRowKey,
 *         bizKey (ComputedRef), bizKeyPlural (ComputedRef),
 *         modalVisible, modalMode, formData, submitLoading
 *   方法: fetchData(), handleSearch(), handleReset(), handlePaginationUpdate(p),
 *         handleCreate(), handleEdit(row), handleDelete(row),
 *         handleBatchDelete(), handleSubmit()
 */
import type { FormDef } from '@/schema/types'
import { useCrudPage } from '@/core/composables/useCrudPage'
import SearchForm from '@/core/SearchForm.vue'
import DataTable from '@/core/DataTable.vue'
import EditModal from '@/core/EditModal.vue'
import { NButton, NSpace, NPopconfirm, useMessage } from 'naive-ui'
import request from '@/utils/request'

const props = defineProps<{ schema: FormDef }>()
const message = useMessage()

const {
  searchParams, tableData, tableLoading, pagination,
  checkedRowKeys, editingRowKey, bizKey,
  modalVisible, modalMode, formData, submitLoading,
  fetchData, handleSearch, handleReset,
  handleCreate, handleEdit, handleDelete, handleBatchDelete,
  handleSubmit, handlePaginationUpdate,
} = useCrudPage(() => props.schema)

// ─── 自定义逻辑 ─────────────────────────────────────────────

// 示例: 自定义工具栏按钮
// async function handleApprove() {
//   if (checkedRowKeys.value.length === 0) {
//     message.warning('请先选择记录')
//     return
//   }
//   await request.post(`/api/v1/${bizKey.value.replace('Code', '')}/batchApprove`, {
//     [bizKeyPlural.value]: checkedRowKeys.value,
//   })
//   message.success('操作成功')
//   fetchData()
// }

// 示例: 覆盖提交行为
// async function handleCustomSubmit() {
//   submitLoading.value = true
//   try {
//     await request.post('/api/v1/order/customSave', { ...formData.value, extra: 'value' })
//     message.success('保存成功')
//     modalVisible.value = false
//     fetchData()
//   } finally {
//     submitLoading.value = false
//   }
